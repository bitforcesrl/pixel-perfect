# Site password
#
# Set it on a deployment and the app asks for it once, then keeps it in that
# browser's IndexedDB and shows itself on every later visit. It is only ever
# compared here on the server (/api/auth), and the same value guards
# /api/screenshot, so it never ships in the client bundle.
#
# Leave it unset (or empty) — the local default — and there is no gate at all.
# Change it and every browser holding the old one drops it and asks again.
SITE_PASSWORD=

# Screenshot browser
#
# Leave BROWSERLESS_TOKEN unset locally: Playwright launches the Chromium it
# installed itself. Set it on Vercel (and any other serverless host, which has
# no browser binary) to drive a remote browser at https://browserless.io.
BROWSERLESS_TOKEN=

# Optional. Overrides the endpoint — another region, or a self-hosted instance.
# The default is Browserless's CDP endpoint, which works with any Playwright
# version. Its /chromium/playwright endpoint is higher fidelity but only works
# when the version it runs matches this project's, so it is opt-in.
# Default: wss://production-sfo.browserless.io
# BROWSERLESS_URL=wss://production-lon.browserless.io

# Optional. How long Browserless keeps the session alive, in ms. Your plan caps
# this and rejects the connection with a 400 if you ask for more — the free tier
# allows 60s. The capture sizes its own waits to fit whatever it is given, so
# raising this on a bigger plan buys taller and slower pages. Default: 60000
# BROWSERLESS_TIMEOUT_MS=60000

# Optional. Routes the session through a Browserless proxy — needs a plan that
# includes one. Its shared datacenter addresses are widely rate limited (Shopify
# answers them with 429 and the word "local_rate_limited"), which a residential
# address avoids. Off a serverless host the capture just retries on your own
# connection instead, so this is only worth setting for a deployment.
# Country is an ISO code, and only applies with a proxy set.
# BROWSERLESS_PROXY=residential
# BROWSERLESS_PROXY_COUNTRY=it

# Optional. How many remote sessions to run at once. Your plan caps this too and
# answers 429 over it; the free tier allows one. One click captures three
# viewports, so anything lower than 3 makes them queue. Default: 1
# BROWSERLESS_CONCURRENCY=1

# Figma export
#
# The Figma button on each viewport card renders the page's Figma frame at 2x
# through the Figma REST API. Leave FIGMA_TOKEN unset and each user is asked
# for their own token, kept in their browser and sent with each export.
# Generate one in Figma: Settings > Security > Personal access tokens, with the
# "File content: Read-only" scope. Rendering images is a Tier 1 endpoint: a
# View or Collab seat gets very few calls, so use a Dev or Full seat.
FIGMA_TOKEN=
