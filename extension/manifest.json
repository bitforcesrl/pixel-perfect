{
  "manifest_version": 3,
  "name": "Pixel Perfect Capture",
  "short_name": "Pixel Perfect",
  "version": "1.1.0",
  "description": "Your site on top of its Figma design: see every pixel that doesn't match. Every viewport, captured in your own Chrome.",
  "homepage_url": "https://pixelperfect.fit",
  "minimum_chrome_version": "120",
  "permissions": ["debugger", "activeTab", "storage", "scripting"],
  "host_permissions": [
    "https://pixelperfect.fit/*",
    "https://www.pixelperfect.fit/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pixelperfect.fit/*",
        "https://www.pixelperfect.fit/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": ["src/bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Pixel Perfect Capture",
    "default_popup": "src/ui/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "src/ui/options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
